  "gpu": 0,
  "log": "$REPO/build-gtx1650/tuning/hcq8_4k.engine.log",
  "env": {
    "STRATA_WEIGHT_ARENA_HOST": "1",
    "STRATA_HEAD_HOST": "1",
    "STRATA_HC_Q8": "1"
